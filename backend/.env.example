# WeatherGPT backend environment configuration
# Copy to .env and fill in real values. NEVER commit .env.
# SECURITY: never put real API keys in this file — placeholders only.

APP_ENV=development
DEBUG=true

# --- Weather provider ---
# Open-Meteo remains the default and does not require a key. To use
# OpenWeather instead, replace WEATHER_API_BASE_URL with:
#   https://api.openweathermap.org/data/2.5
# and set WEATHER_API_KEY to your OpenWeather appid.
# OpenWeather's free forecast endpoint provides up to 5 days in 3-hour steps.
# Provider endpoints used by the default Open-Meteo setup:
#   Weather Forecast API  → https://api.open-meteo.com/v1/forecast
#   Geocoding API         → https://geocoding-api.open-meteo.com/v1/search
#
# OpenWeather setup:
#WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
#WEATHER_API_KEY=8176df91ab6f595a652e3b4380801e04
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# --- LLM (LangChain + Google Gemini Flash) ---
# Get a free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Cache ---
REDIS_URL=redis://localhost:6379/0
CACHE_CURRENT_TTL_SECONDS=600
CACHE_FORECAST_TTL_SECONDS=1800
CACHE_GEOCODE_TTL_SECONDS=21600

# --- Database ---
# Local dev default is SQLite; use PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/weathergpt
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db

# --- Auth ---
JWT_SECRET=change_this_in_production

# --- Alerts / notifications ---
ALERT_SCHEDULER_ENABLED=false
ALERT_CHECK_INTERVAL_SECONDS=900
FIREBASE_PROJECT_ID=
# Inline service-account JSON or a path to the JSON file — enables real FCM
# push delivery. Without it, alert dispatch runs in dry-run (logged) mode.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- RAG (optional) ---
RAG_ENABLED=false
CHROMA_DIR=./chroma_db

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CHAT_RATE_LIMIT_REQUESTS=10
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
