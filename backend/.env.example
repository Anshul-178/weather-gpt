# WeatherGPT backend configuration template.
# Copy to .env and fill in values. NEVER commit a .env with real keys.

# --- Application ---
APP_ENV=development
DEBUG=true

# --- LLM providers (multi-provider fallback) ---
# Provider order is configurable; first available provider wins.
LLM_PROVIDER_ORDER=gemini,mistral,groq

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- LLM behaviour tuning (optional; defaults shown) ---
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_OUTPUT_TOKENS=600
# LLM_RATE_LIMIT_COOLDOWN_SECONDS=60
# LLM_FAILURE_COOLDOWN_SECONDS=120
# LLM_INVALID_KEY_COOLDOWN_SECONDS=1800
# LLM_MAX_CONSECUTIVE_FAILURES=3
# LLM_MAX_TRANSIENT_RETRIES=2

# --- Weather provider (Open-Meteo by default; no key needed) ---
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
# WEATHER_API_KEY=

# --- Cache (in-memory, no external service) / Database / Auth ---
DATABASE_URL=sqlite+aiosqlite:///./weathergpt.db
JWT_SECRET=change_this_in_production
